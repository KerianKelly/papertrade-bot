# Copy to .env. Only needed for LIVE mode.
# Use a FRESH wallet created only for this bot, funded with just the $50 you are testing with.
WALLET_PRIVATE_KEY=0x...

# STRATEGY=trade               # trade (hedge pair with stops) | farm (hold the hedge, close both at FARM_MOVE_BPS, mint PAPER cheaply)
# FARM_MOVE_BPS=60             # farm: close both legs once price has moved this far from entry (100x bust is ~95 bps)
# FARM_BUST_GUARD=0.85         # farm: close both if a leg is this fraction of the way to liquidation
# FARM_BUDGET_USD=25           # farm: stop starting cycles after this much has been spent on PAPER (live: counted over the account's whole history); 0 = no cap

# Strategy overrides (defaults shown)
# MARGIN_PER_LEG_USD=10        # contract minimum is $10
# LEVERAGE=100                 # backtest: 100x/30%/30% was least-bad (~-$0.23/pair); 1000x lost ~$4/pair
# MAX_CONCURRENT_PAIRS=2
# ONE_PAIR_PER_ASSET=true      # concurrent pairs go on different assets (same asset = same bet twice)
# MIN_ACTIVITY_BPS=4           # don't start a pair unless price travelled this many bps in the last minute
# LOSER_STOP_PCT=0.30          # close the losing leg at -30% of its margin
# TAKE_PROFIT_PCT=0.30         # pair target: +30% of pair margin (+$6 on a $20 pair)
# WINNER_FLOOR_PCT=0.05        # close the winning leg before its own profit falls below +5%
# BREAKEVEN_BUFFER_PCT=0.01    # once the loss is covered, don't give it back
# TRAIL_GIVEBACK_PCT=0.30      # when riding momentum, exit after giving back 30% of peak profit
# STALL_MS=3000                # momentum counts as stopped after 3s with no new extreme
# MAX_PAIR_HOLD_MS=            # close both legs after this; default 15 min at >100x, 2 h at <=100x
# MAX_SESSION_LOSS_USD=25      # stop opening new pairs after losing this much
# FEED_STALE_FLATTEN_MS=      # close open legs if prices stop arriving for this long; default 10 s at >100x, 60 s at <=100x
# OPEN_DEADLINE_SEC=300        # open intents expire at the relayer after this (so a crashed bot can't fill later)
# OPEN_TIMEOUT_MS=20000        # give up on (and cancel) an open that hasn't filled within this
# SECOND_LEG_GRACE_MS=8000     # once one leg fills, abort the other if it hasn't filled within this
# ON_START_EXISTING=close      # close|ignore positions already open when the bot starts
# AUTO_CLAIM_REWARDS=false     # true = claim USDC staking rewards hourly into the trading balance (they then fund farming)
# STAKE_INTERVAL_MS=900000     # stake PAPER every 15 min (protocol minimum is 1000 PAPER)
